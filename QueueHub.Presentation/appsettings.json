{
  "Jwt": {
    "Issuer": "QueueHub",
    "Audience": "QueueHubUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "QueueHubLogs",
    "ExceptionLogsCollection": "exception_logs"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}